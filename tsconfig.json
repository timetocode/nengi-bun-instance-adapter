{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "nengi": [
        "../nengi/build"
      ],
      "nengi-dataviews": [
        "../nengi-dataviews/build"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "build/**/*"
  ]
}
